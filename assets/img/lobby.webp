    <rect x="0" y="0" width="220" height="440" rx="10" fill="#171411" stroke="#D4A243" stroke-width="2"/>
    <path d="M15 390 Q90 270 205 90" fill="none" stroke="#F5C84C" stroke-width="4"/>
    <path d="M40 120 Q110 180 195 165" fill="none" stroke="#E2A42B" stroke-width="2.2"/>
    <rect x="260" y="0" width="220" height="440" rx="10" fill="#F3ECE1" stroke="#D5C6B0" stroke-width="2"/>
    <path d="M275 360 Q350 250 460 110" fill="none" stroke="#C8B294" stroke-width="3"/>
    <rect x="520" y="0" width="220" height="440" rx="10" fill="#EBE2D5" stroke="#CBBBA4" stroke-width="2"/>
    <path d="M540 380 Q630 280 720 130" fill="none" stroke="#B59E7D" stroke-width="3"/>
